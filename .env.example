# Public storefront settings
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_SUPPORT_EMAIL=hello@kleid.in
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_ANNOUNCEMENT_TEXT=Free shipping on prepaid orders above ₹1,999
NEXT_PUBLIC_ANNOUNCEMENT_LINK_LABEL=Shop the collection

# Admin login — server only.
# LOCAL DEVELOPMENT:
# Copy this file to .env.local and set your own values.
# Never commit your real .env.local credentials.
ADMIN_EMAIL=admin@kleid.in
ADMIN_PASSWORD=change-this-password

# PRODUCTION:
# Required in production. Use a long random value (32+ characters).
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional hashed-password mode.
# When both values are set they take precedence over ADMIN_PASSWORD.
# ADMIN_PASSWORD_SALT=
# ADMIN_PASSWORD_HASH=


# Supabase — server-side product database and storage
# Keep SUPABASE_SERVICE_ROLE_KEY private. Never expose it with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
