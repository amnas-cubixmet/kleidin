# Public storefront fallback settings.
# Once MongoDB is connected, these can be changed from Admin > Store Settings
# without editing code or redeploying.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_SUPPORT_EMAIL=hello@kleid.in
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Admin login — server only.
# On Vercel add these under Project Settings > Environment Variables.
# Production requires ADMIN_SESSION_SECRET (32+ random characters).
ADMIN_EMAIL=admin@kleid.in
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# ADMIN_PASSWORD_SALT=
# ADMIN_PASSWORD_HASH=

# MongoDB Atlas — database source of truth
# Keep MONGODB_URI server-only. Never expose it with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kleidin

# Cloudinary — product / hero / featured-animation media.
# Uploads use signed browser-to-Cloudinary requests so large images do not
# have to pass through the Vercel function request body. Keep API_SECRET server-only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
